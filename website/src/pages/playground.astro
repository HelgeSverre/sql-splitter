---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Playground — sql-splitter"
  description="Generate synthetic data from your SQL dump, entirely in your browser. Your dump never leaves your machine."
>
  <div class="playground" x-data="playground" x-cloak>
    <header class="pg-header">
      <h1>Synthetic data playground</h1>
      <p class="pg-privacy">
        <span class="lock">&#128274;</span>
        Your dump never leaves your machine — parsing, profiling, and generation run
        entirely in your browser via WebAssembly. No uploads, no network requests
        after page load (check DevTools).
      </p>
    </header>

    <div class="pg-topbar">
      <div class="pg-file-info">
        <template x-if="fileName">
          <span>
            <span class="pg-file-name" x-text="fileName"></span>
            <span class="pg-chip" x-text="summary ? summary.dialect + (summary.dialectDetected ? ' · detected' : '') : dialect"></span>
          </span>
        </template>
        <template x-if="!fileName">
          <span class="pg-muted">No dump loaded</span>
        </template>
      </div>
      <div class="pg-topbar-actions">
        <label class="pg-select-label">
          Dialect
          <select x-model="dialect">
            <option value="auto">auto-detect</option>
            <option value="mysql">mysql</option>
            <option value="postgres">postgres</option>
            <option value="sqlite">sqlite</option>
            <option value="mssql">mssql</option>
          </select>
        </label>
        <button class="pg-btn" x-on:click="$refs.fileInput.click()">Open file</button>
        <input type="file" accept=".sql,.txt,.dump" x-ref="fileInput" hidden
               x-on:change="openFile($event.target.files[0]); $event.target.value = ''" />
        <div class="pg-examples" x-data="{ open: false }" x-on:click.outside="open = false">
          <button class="pg-btn" x-on:click="open = !open">Examples &#9662;</button>
          <div class="pg-examples-menu" x-show="open" x-on:click="open = false">
            <button x-on:click="loadExample('example-mysql.sql')">MySQL — web shop</button>
            <button x-on:click="loadExample('example-postgres.sql')">PostgreSQL — COPY format</button>
          </div>
        </div>
      </div>
    </div>

    <div class="pg-banner pg-error" x-show="error" x-text="error"></div>
    <div class="pg-banner pg-warn" x-show="perfWarning" x-text="perfWarning"></div>

    <div class="pg-workbench"
         x-on:dragover.prevent="dragging = true"
         x-on:dragleave.prevent="dragging = false"
         x-on:drop.prevent="dragging = false; openFile($event.dataTransfer.files[0])"
         x-bind:class="{ dragging: dragging }">

      <!-- Empty state -->
      <template x-if="!summary && state !== 'analyzing'">
        <div class="pg-empty">
          <div class="pg-drop-icon">&#8681;</div>
          <p class="pg-drop-title">Drop a .sql dump anywhere on this panel</p>
          <p class="pg-muted">
            or <a href="#" x-on:click.prevent="$refs.fileInput.click()">browse for a file</a>,
            or try an example above
          </p>
          <p class="pg-drop-note pg-muted">
            MySQL, PostgreSQL, SQLite, and MSSQL dumps. Compressed files aren't
            supported in the browser — decompress first, or use the CLI.
          </p>
        </div>
      </template>

      <!-- Busy state -->
      <template x-if="state === 'analyzing'">
        <div class="pg-empty">
          <div class="pg-spinner"></div>
          <p class="pg-drop-title">Analyzing dump&hellip;</p>
          <p class="pg-muted">Profiling tables, observing value shapes, inferring generators</p>
        </div>
      </template>

      <!-- Workbench -->
      <template x-if="summary">
        <div class="pg-ide">
          <aside class="pg-sidebar">
            <div class="pg-sidebar-title">Tables</div>
            <template x-for="table in summary.tables" x-bind:key="table.name">
              <button class="pg-table-item"
                      x-bind:class="{ selected: selectedTable === table.name }"
                      x-on:click="selectedTable = table.name; tab = 'analysis'">
                <span class="pg-table-name" x-text="table.name"></span>
                <span class="pg-table-rows"
                      x-text="table.rowCount === null ? 'schema' : table.rowCount + ' rows'"></span>
              </button>
            </template>
            <div class="pg-sidebar-warnings" x-show="summary.warnings.length > 0">
              <details>
                <summary x-text="'&#9888; ' + summary.warnings.length + ' warning' + (summary.warnings.length === 1 ? '' : 's')"></summary>
                <ul>
                  <template x-for="w in summary.warnings">
                    <li x-text="w"></li>
                  </template>
                </ul>
              </details>
            </div>
          </aside>

          <section class="pg-main">
            <div class="pg-tabs">
              <button x-bind:class="{ active: tab === 'analysis' }" x-on:click="tab = 'analysis'">Analysis</button>
              <button x-bind:class="{ active: tab === 'sql' }" x-on:click="tab = 'sql'"
                      x-bind:disabled="!sql && state !== 'generating'">Generated SQL</button>
            </div>

            <div class="pg-tab-content" x-show="tab === 'analysis'">
              <template x-if="currentTable">
                <div>
                  <div class="pg-table-header">
                    <h2 x-text="currentTable.name"></h2>
                    <span class="pg-muted"
                          x-text="currentTable.rowCount === null ? 'no rows observed — schema-only inference' : currentTable.rowCount + ' rows observed'"></span>
                  </div>
                  <template x-for="fk in currentTable.foreignKeys">
                    <p class="pg-fk">
                      <span x-text="fk.columns.join(', ')"></span> &rarr;
                      <span x-text="fk.referencedTable"></span>(<span x-text="fk.referencedColumns.join(', ')"></span>)
                    </p>
                  </template>
                  <table class="pg-columns">
                    <thead>
                      <tr>
                        <th>Column</th><th>Type</th><th>Nulls</th><th>Distinct</th>
                        <th>Generator</th><th>Confidence</th>
                      </tr>
                    </thead>
                    <tbody>
                      <template x-for="col in currentTable.columns" x-bind:key="col.name">
                        <tr>
                          <td class="pg-col-name">
                            <span x-text="col.name"></span>
                            <span class="pg-pk" x-show="col.primaryKey" title="primary key">PK</span>
                          </td>
                          <td class="pg-mono" x-text="col.sqlType"></td>
                          <td x-text="col.nullRate === null ? '—' : Math.round(col.nullRate * 100) + '%'"></td>
                          <td x-text="col.distinctEstimate === null ? '—' : Math.round(col.distinctEstimate)"></td>
                          <td>
                            <span class="pg-mono" x-text="col.generator ?? '—'"></span>
                            <span class="pg-semantic" x-show="col.semantic" x-text="col.semantic"></span>
                          </td>
                          <td>
                            <span class="pg-confidence" x-show="col.confidence"
                                  x-bind:data-level="col.confidence"
                                  x-bind:title="col.reason">
                              <span class="dot"></span><span x-text="col.confidence"></span>
                            </span>
                          </td>
                        </tr>
                      </template>
                    </tbody>
                  </table>
                </div>
              </template>
            </div>

            <div class="pg-tab-content pg-sql" x-show="tab === 'sql'">
              <template x-if="state === 'generating'">
                <div class="pg-empty">
                  <div class="pg-spinner"></div>
                  <p class="pg-drop-title">Generating&hellip;</p>
                </div>
              </template>
              <template x-if="sql && state !== 'generating'">
                <div>
                  <p class="pg-muted pg-sql-note" x-show="sqlTruncatedNote" x-text="sqlTruncatedNote"></p>
                  <pre><code x-text="displaySql"></code></pre>
                </div>
              </template>
            </div>
          </section>
        </div>
      </template>
    </div>

    <div class="pg-bottombar" x-show="summary">
      <label>
        Rows per root table
        <input type="number" min="1" x-model.number="rows" />
      </label>
      <label>
        Seed
        <input type="number" min="0" x-model.number="seed" />
      </label>
      <button class="pg-btn pg-btn-primary"
              x-on:click="generate()"
              x-bind:disabled="state === 'generating' || state === 'analyzing'">
        &#9654; Generate
      </button>
      <span class="pg-muted pg-rows-note" x-show="rows > 100000">
        Large row counts can take a while and produce a very large script in browser memory.
      </span>
      <span class="pg-bottombar-spacer"></span>
      <button class="pg-btn" x-show="sql" x-on:click="copySql($event)">Copy</button>
      <button class="pg-btn" x-show="sql" x-on:click="downloadSql()">Download .sql</button>
    </div>

    <p class="pg-footer-note">
      This is the real <a href="/commands/generate/">sql-splitter generate</a> engine
      compiled to WebAssembly — the same profiler, inference, and generators the CLI
      runs on your machine. For multi-GB dumps, scheduled jobs, or model config files,
      <a href="/getting-started/">install the CLI</a>.
    </p>
  </div>
</BaseLayout>

<script>
  import Alpine from 'alpinejs';

  interface ColumnInfo {
    name: string;
    sqlType: string;
    nullable: boolean;
    primaryKey: boolean;
    nullRate: number | null;
    distinctEstimate: number | null;
    generator: string | null;
    semantic: string | null;
    confidence: string | null;
    reason: string | null;
  }

  interface TableInfo {
    name: string;
    rowCount: number | null;
    foreignKeys: {
      columns: string[];
      referencedTable: string;
      referencedColumns: string[];
    }[];
    columns: ColumnInfo[];
  }

  interface Summary {
    dialect: string;
    dialectDetected: boolean;
    tables: TableInfo[];
    warnings: string[];
  }

  type WorkerReply =
    | { id: number; type: 'status'; stage: string }
    | { id: number; type: 'analyzed'; summary: Summary }
    | { id: number; type: 'generated'; sql: string }
    | { id: number; type: 'error'; message: string; fatal: boolean };

  const MAGIC = [
    { bytes: [0x1f, 0x8b], name: 'gzip' },
    { bytes: [0x50, 0x4b], name: 'zip' },
    { bytes: [0x42, 0x5a, 0x68], name: 'bzip2' },
    { bytes: [0xfd, 0x37, 0x7a, 0x58, 0x5a], name: 'xz' },
    { bytes: [0x28, 0xb5, 0x2f, 0xfd], name: 'zstd' },
  ];
  const SOFT_WARN_BYTES = 100 * 1024 * 1024;
  const DISPLAY_CAP = 1024 * 1024;

  Alpine.data('playground', () => ({
    state: 'empty' as 'empty' | 'analyzing' | 'ready' | 'generating',
    dragging: false,
    fileName: null as string | null,
    dialect: 'auto',
    summary: null as Summary | null,
    selectedTable: null as string | null,
    tab: 'analysis' as 'analysis' | 'sql',
    rows: 100,
    seed: 42,
    sql: null as string | null,
    error: null as string | null,
    perfWarning: null as string | null,

    worker: null as Worker | null,
    requestId: 0,

    init() {
      this.spawnWorker();
    },

    spawnWorker() {
      if (this.worker) this.worker.terminate();
      this.worker = new Worker('/wasm/worker.js', { type: 'module' });
      this.worker.onmessage = (event: MessageEvent<WorkerReply>) =>
        this.onWorkerMessage(event.data);
      this.worker.onerror = () => {
        this.state = this.summary ? 'ready' : 'empty';
        this.error = 'The WebAssembly worker failed to load.';
      };
    },

    onWorkerMessage(msg: WorkerReply) {
      if (msg.id !== this.requestId) return; // stale reply from a superseded request
      if (msg.type === 'analyzed') {
        this.summary = msg.summary;
        this.selectedTable = msg.summary.tables[0]?.name ?? null;
        this.tab = 'analysis';
        this.sql = null;
        this.state = 'ready';
      } else if (msg.type === 'generated') {
        this.sql = msg.sql;
        this.tab = 'sql';
        this.state = 'ready';
      } else if (msg.type === 'error') {
        this.error = msg.message;
        if (msg.fatal) {
          this.spawnWorker();
          this.summary = null;
          this.fileName = null;
          this.state = 'empty';
        } else {
          this.state = this.summary ? 'ready' : 'empty';
        }
      }
    },

    get currentTable() {
      return this.summary?.tables.find((t: TableInfo) => t.name === this.selectedTable) ?? null;
    },

    get displaySql() {
      if (!this.sql) return '';
      return this.sql.length > DISPLAY_CAP ? this.sql.slice(0, DISPLAY_CAP) : this.sql;
    },

    get sqlTruncatedNote() {
      if (!this.sql || this.sql.length <= DISPLAY_CAP) return null;
      const totalMb = (this.sql.length / (1024 * 1024)).toFixed(1);
      return `Showing the first 1 MB of ${totalMb} MB — Download gets the full script.`;
    },

    async openFile(file: File | null | undefined) {
      if (!file) return;
      this.error = null;
      this.perfWarning = null;

      const buffer = await file.arrayBuffer();
      const head = new Uint8Array(buffer, 0, Math.min(8, buffer.byteLength));
      const compressed = MAGIC.find((m) => m.bytes.every((b, i) => head[i] === b));
      if (compressed) {
        this.error = `This looks like a ${compressed.name} archive. Compressed dumps aren't supported in the browser — decompress it first, or use the CLI (which reads them natively).`;
        return;
      }
      if (file.size >= SOFT_WARN_BYTES) {
        const mb = Math.round(file.size / (1024 * 1024));
        this.perfWarning = `${mb} MB dump — analysis runs locally and may take a while, briefly using roughly twice the file size in memory. Leave the tab open.`;
      }

      this.fileName = file.name;
      this.analyze(buffer);
    },

    async loadExample(name: string) {
      this.error = null;
      this.perfWarning = null;
      const response = await fetch(`/playground/${name}`);
      const buffer = await response.arrayBuffer();
      this.fileName = name;
      this.analyze(buffer);
    },

    analyze(buffer: ArrayBuffer) {
      this.state = 'analyzing';
      this.summary = null;
      this.sql = null;
      const id = ++this.requestId;
      const dialect = this.dialect === 'auto' ? null : this.dialect;
      this.worker?.postMessage({ id, type: 'analyze', buffer, dialect }, [buffer]);
    },

    generate() {
      if (!this.summary) return;
      this.error = null;
      this.state = 'generating';
      this.tab = 'sql';
      const id = ++this.requestId;
      this.worker?.postMessage({ id, type: 'generate', rows: this.rows || 100, seed: this.seed || 0 });
    },

    copySql(event: Event) {
      if (!this.sql) return;
      navigator.clipboard.writeText(this.sql).then(() => {
        const btn = event.target as HTMLButtonElement;
        const original = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => (btn.textContent = original), 1500);
      });
    },

    downloadSql() {
      if (!this.sql) return;
      const blob = new Blob([this.sql], { type: 'application/sql' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'synthetic.sql';
      a.click();
      URL.revokeObjectURL(url);
    },
  }));

  Alpine.start();
</script>

<style>
  [x-cloak] {
    display: none !important;
  }

  /* Full-width workbench: break out of BaseLayout's 780px column */
  :global(main:has(.playground)) {
    max-width: 1500px;
  }

  .pg-header h1 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    margin-bottom: var(--space-xs);
  }

  .pg-privacy {
    color: var(--color-text-muted);
    max-width: 70ch;
    margin-bottom: var(--space-md);
  }

  .pg-privacy .lock {
    margin-right: 0.25rem;
  }

  .pg-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    padding: var(--space-xs) var(--space-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .pg-file-name {
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  .pg-chip {
    display: inline-block;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 0.1rem 0.5rem;
    margin-left: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--cmd-generate);
  }

  .pg-topbar-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .pg-select-label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  select,
  input[type='number'] {
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.35rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  input[type='number'] {
    width: 6.5rem;
  }

  .pg-btn {
    background: var(--color-bg);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: 0.4rem 0.85rem;
    font-size: 0.85rem;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }

  .pg-btn:hover {
    border-color: var(--cmd-generate);
    color: var(--cmd-generate);
  }

  .pg-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .pg-btn-primary {
    background: var(--cmd-generate);
    border-color: var(--cmd-generate);
    color: var(--color-bg);
    font-weight: 600;
  }

  .pg-btn-primary:hover {
    color: var(--color-bg);
    opacity: 0.9;
  }

  .pg-examples {
    position: relative;
  }

  .pg-examples-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 4px);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    min-width: 220px;
    z-index: 20;
    overflow: hidden;
  }

  .pg-examples-menu button {
    background: none;
    border: none;
    color: var(--color-text);
    text-align: left;
    padding: 0.5rem 0.85rem;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .pg-examples-menu button:hover {
    background: var(--color-bg);
    color: var(--cmd-generate);
  }

  .pg-banner {
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-top: none;
    font-size: 0.875rem;
  }

  .pg-error {
    color: var(--cmd-redact);
    border-left: 3px solid var(--cmd-redact);
  }

  .pg-warn {
    color: var(--cmd-diff);
    border-left: 3px solid var(--cmd-diff);
  }

  .pg-workbench {
    border: 1px solid var(--color-border);
    border-top: none;
    min-height: 62vh;
    display: flex;
    flex-direction: column;
  }

  .pg-workbench.dragging {
    outline: 2px dashed var(--cmd-generate);
    outline-offset: -8px;
  }

  .pg-empty {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-xl) var(--space-md);
    gap: var(--space-xs);
  }

  .pg-drop-icon {
    font-size: 2.5rem;
    color: var(--cmd-generate);
  }

  .pg-drop-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
  }

  .pg-drop-note {
    font-size: 0.85rem;
    max-width: 55ch;
  }

  .pg-muted {
    color: var(--color-text-muted);
  }

  .pg-spinner {
    width: 28px;
    height: 28px;
    border: 3px solid var(--color-border);
    border-top-color: var(--cmd-generate);
    border-radius: 50%;
    animation: pg-spin 0.8s linear infinite;
  }

  @keyframes pg-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .pg-ide {
    display: grid;
    grid-template-columns: 240px 1fr;
    flex: 1;
    min-height: 0;
  }

  .pg-sidebar {
    border-right: 1px solid var(--color-border);
    padding: var(--space-sm) 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-y: auto;
  }

  .pg-sidebar-title {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    padding: 0 var(--space-sm) var(--space-xs);
  }

  .pg-table-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-xs);
    background: none;
    border: none;
    border-left: 2px solid transparent;
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.35rem var(--space-sm);
    cursor: pointer;
    text-align: left;
  }

  .pg-table-item:hover {
    color: var(--cmd-generate);
  }

  .pg-table-item.selected {
    border-left-color: var(--cmd-generate);
    background: var(--color-surface);
    color: var(--cmd-generate);
  }

  .pg-table-rows {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .pg-sidebar-warnings {
    margin-top: auto;
    padding: var(--space-xs) var(--space-sm) 0;
    font-size: 0.8rem;
    color: var(--cmd-diff);
  }

  .pg-sidebar-warnings summary {
    cursor: pointer;
  }

  .pg-sidebar-warnings ul {
    list-style: none;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    margin-top: var(--space-xs);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .pg-main {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .pg-tabs {
    display: flex;
    border-bottom: 1px solid var(--color-border);
  }

  .pg-tabs button {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--color-text-muted);
    font-size: 0.9rem;
    padding: 0.6rem var(--space-sm);
    cursor: pointer;
  }

  .pg-tabs button.active {
    color: var(--color-text);
    border-bottom-color: var(--cmd-generate);
  }

  .pg-tabs button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .pg-tab-content {
    padding: var(--space-sm);
    overflow: auto;
    flex: 1;
    min-height: 0;
  }

  .pg-table-header {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }

  .pg-table-header h2 {
    font-family: var(--font-mono);
    font-size: 1.1rem;
  }

  .pg-fk {
    font-family: var(--font-mono);
    font-size: 0.8rem;
