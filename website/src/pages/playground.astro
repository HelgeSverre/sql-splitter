---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Playground — sql-splitter"
  description="Generate synthetic data from your SQL dump, entirely in your browser. Your dump never leaves your machine."
>
  <div class="playground" x-data="playground" x-cloak>
    <div class="pg-topbar">
      <div class="pg-title-group">
        <div class="pg-file-info">
          <template x-if="fileName">
            <span>
              <span class="pg-file-name" x-text="fileName"></span>
              <span
                class="pg-chip"
                x-text="summary ? summary.dialect + (summary.dialectDetected ? ' · detected' : '') : dialect"
              ></span>
            </span>
          </template>
          <template x-if="!fileName">
            <span class="pg-muted">No dump loaded</span>
          </template>
        </div>
      </div>
      <div class="pg-topbar-actions">
        <label class="pg-select-label">
          Dialect
          <select x-model="dialect">
            <option value="auto">auto-detect</option>
            <option value="mysql">mysql</option>
            <option value="postgres">postgres</option>
            <option value="sqlite">sqlite</option>
            <option value="mssql">mssql</option>
          </select>
        </label>
        <button class="pg-btn" x-on:click="$refs.fileInput.click()">Open file</button>
        <input
          type="file"
          accept=".sql,.txt,.dump"
          x-ref="fileInput"
          hidden
          x-on:change="openFile($event.target.files[0]); $event.target.value = ''"
        />
        <div class="pg-examples" x-data="{ open: false }" x-on:click.outside="open = false">
          <button class="pg-btn" x-on:click="open = !open">Examples &#9662;</button>
          <div class="pg-examples-menu" x-show="open" x-on:click="open = false">
            <button x-on:click="loadExample('example-mysql.sql')">
              MySQL — multi-tenant SaaS
            </button>
            <button x-on:click="loadExample('example-postgres.sql')">
              PostgreSQL — multi-tenant SaaS (COPY)
            </button>
          </div>
        </div>
      </div>
    </div>

    <div
      class="pg-workbench"
      x-on:dragover.prevent="dragging = true"
      x-on:dragleave.prevent="dragging = false"
      x-on:drop.prevent="dragging = false; openFile($event.dataTransfer.files[0])"
      x-bind:class="{ dragging: dragging }"
    >
      <!-- Overlaid banners: appearing/disappearing never shifts the layout -->
      <div class="pg-overlays">
        <div class="pg-banner pg-error" x-show="error">
          <span x-text="error"></span>
          <button class="pg-dismiss" x-on:click="error = null" aria-label="Dismiss">&times;</button>
        </div>
        <div class="pg-banner pg-warn" x-show="perfWarning">
          <span x-text="perfWarning"></span>
          <button class="pg-dismiss" x-on:click="perfWarning = null" aria-label="Dismiss">
            &times;
          </button>
        </div>
      </div>

      <!-- Empty state -->
      <template x-if="!summary && state !== 'analyzing'">
        <div class="pg-empty">
          <div class="pg-drop-icon">&#8681;</div>
          <p class="pg-drop-title">Drop a .sql dump anywhere on this panel</p>
          <p class="pg-muted">
            or <a href="#" x-on:click.prevent="$refs.fileInput.click()">browse for a file</a>, or
            try an example above
          </p>
          <p class="pg-drop-note pg-muted">
            MySQL, PostgreSQL, SQLite, and MSSQL dumps. Compressed files aren't supported in the
            browser — decompress first, or use the CLI.
          </p>
        </div>
      </template>

      <!-- Busy state -->
      <template x-if="state === 'analyzing'">
        <div class="pg-empty">
          <div class="pg-spinner"></div>
          <p class="pg-drop-title">Analyzing dump&hellip;</p>
          <p class="pg-muted">Profiling tables, observing value shapes, inferring generators</p>
        </div>
      </template>

      <!-- Workbench -->
      <template x-if="summary">
        <div class="pg-ide">
          <aside class="pg-sidebar">
            <div class="pg-sidebar-title">Tables</div>
            <template x-for="table in summary.tables" x-bind:key="table.name">
              <button
                class="pg-table-item"
                x-bind:class="{ selected: selectedTable === table.name }"
                x-on:click="selectedTable = table.name; tab = 'analysis'"
              >
                <span class="pg-table-name" x-text="table.name"></span>
                <span
                  class="pg-table-rows"
                  x-text="table.rowCount === null ? 'schema' : table.rowCount + ' rows'"
                ></span>
              </button>
            </template>
          </aside>

          <section class="pg-main">
            <div class="pg-tabs">
              <button
                x-bind:class="{ active: tab === 'analysis' }"
                x-on:click="switchTab('analysis')">Analysis</button
              >
              <button x-bind:class="{ active: tab === 'model' }" x-on:click="switchTab('model')"
                >Model</button
              >
              <button
                x-bind:class="{ active: tab === 'sql' }"
                x-on:click="switchTab('sql')"
                x-bind:disabled="!sql && state !== 'generating'">Generated SQL</button
              >
              <button
                x-bind:class="{ active: tab === 'warnings' }"
                x-on:click="switchTab('warnings')"
              >
                Warnings
                <span class="pg-tab-badge" x-show="warningCount > 0" x-text="warningCount"></span>
              </button>
            </div>

            <div class="pg-tab-content" x-show="tab === 'analysis'">
              <template x-if="currentTable">
                <div>
                  <div class="pg-table-header">
                    <h2 x-text="currentTable.name"></h2>
                    <span
                      class="pg-muted"
                      x-text="currentTable.rowCount === null ? 'no rows observed — schema-only inference' : currentTable.rowCount + ' rows observed'"
                    ></span>
                  </div>
                  <template x-for="fk in currentTable.foreignKeys">
                    <p class="pg-fk">
                      <span x-text="fk.columns.join(', ')"></span> &rarr;
                      <span x-text="fk.referencedTable"></span>(<span
                        x-text="fk.referencedColumns.join(', ')"></span
                      >)
                    </p>
                  </template>
                  <table class="pg-columns">
                    <thead>
                      <tr>
                        <th>Column</th><th>Type</th><th>Nulls</th><th>Distinct</th>
                        <th>Generator</th><th>Confidence</th>
                      </tr>
                    </thead>
                    <tbody>
                      <template x-for="col in currentTable.columns" x-bind:key="col.name">
                        <tr>
                          <td class="pg-col-name">
                            <span x-text="col.name"></span>
                            <span class="pg-pk" x-show="col.primaryKey" title="primary key"
                              >PK</span
                            >
                          </td>
                          <td class="pg-mono" x-text="col.sqlType"></td>
                          <td
                            x-text="col.nullRate === null ? '—' : Math.round(col.nullRate * 100) + '%'"
                          ></td>
                          <td
                            x-text="col.distinctEstimate === null ? '—' : Math.round(col.distinctEstimate)"
                          ></td>
                          <td>
                            <span class="pg-mono" x-text="col.generator ?? '—'"></span>
                            <span
                              class="pg-semantic"
                              x-show="col.semantic"
                              x-text="col.semantic"></span>
                          </td>
                          <td>
                            <span
                              class="pg-confidence"
                              x-show="col.confidence"
                              x-bind:data-level="col.confidence"
                              x-bind:title="col.reason"
                            >
                              <span class="dot"></span><span x-text="col.confidence"></span>
                            </span>
                          </td>
                        </tr>
                      </template>
                    </tbody>
                  </table>
                </div>
              </template>
            </div>

            <div class="pg-tab-content pg-model" x-show="tab === 'model'">
              <div class="pg-model-actions">
                <span class="pg-muted">
                  The resolved model — reproduce this exact run with the CLI:
                </span>
                <code>sql-splitter generate -c model.yaml -o synthetic.sql</code>
                <span class="pg-actions-spacer"></span>
                <button class="pg-btn" x-show="modelYamlText" x-on:click="copyModel($event)"
                  >Copy</button
                >
                <button class="pg-btn" x-show="modelYamlText" x-on:click="downloadModel()"
                  >Download model.yaml</button
                >
              </div>
              <template x-if="modelLoading">
                <div class="pg-empty"><div class="pg-spinner"></div></div>
              </template>
              <template x-if="modelHtml && !modelLoading">
                <div class="pg-code" x-html="modelHtml"></div>
              </template>
              <template x-if="modelYamlText && !modelHtml && !modelLoading">
                <pre><code x-text="modelYamlText"></code></pre>
              </template>
            </div>

            <div class="pg-tab-content pg-sql" x-show="tab === 'sql'">
              <template x-if="state === 'generating'">
                <div class="pg-empty">
                  <div class="pg-spinner"></div>
                  <p class="pg-drop-title">Generating&hellip;</p>
                </div>
              </template>
              <template x-if="sql && state !== 'generating'">
                <div>
                  <p
                    class="pg-muted pg-sql-note"
                    x-show="sqlTruncatedNote"
                    x-text="sqlTruncatedNote"></p>
                  <template x-if="sqlHtml">
                    <div class="pg-code" x-html="sqlHtml"></div>
                  </template>
                  <template x-if="!sqlHtml">
                    <pre><code x-text="displaySql"></code></pre>
                  </template>
                </div>
              </template>
            </div>

            <div class="pg-tab-content pg-warnings" x-show="tab === 'warnings'">
              <template x-if="warningCount === 0">
                <p class="pg-muted">No warnings.</p>
              </template>
              <section x-show="summary && summary.warnings.length > 0">
                <h3>From analysis</h3>
                <template x-for="w in summary.warnings">
                  <article class="pg-warning" x-bind:data-severity="w.severity">
                    <header>
                      <span class="pg-sev" x-text="w.severity"></span>
                      <template x-if="w.documentationUrl">
                        <a
                          class="pg-wcode"
                          x-bind:href="w.documentationUrl"
                          target="_blank"
                          rel="noopener"
                          x-text="w.code"></a>
                      </template>
                      <template x-if="!w.documentationUrl">
                        <span class="pg-wcode" x-text="w.code"></span>
                      </template>
                      <span class="pg-wpath pg-mono" x-text="w.path"></span>
                    </header>
                    <p x-text="w.message"></p>
                    <p class="pg-muted pg-whelp" x-show="w.help" x-text="w.help"></p>
                    <details class="pg-wexplain" x-show="w.definition">
                      <summary>What is this?</summary>
                      <p><strong x-text="w.definition?.title"></strong></p>
                      <p x-text="w.definition?.summary"></p>
                      <p class="pg-muted">
                        Category: <span x-text="w.definition?.category"></span> &middot; Typical
                        severity: <span x-text="w.definition?.typicalSeverity"></span>
                      </p>
                    </details>
                  </article>
                </template>
              </section>
              <section x-show="renderWarnings.length > 0">
                <h3>From last generation</h3>
                <template x-for="w in renderWarnings">
                  <article class="pg-warning" x-bind:data-severity="w.severity">
                    <header>
                      <span class="pg-sev" x-text="w.severity"></span>
                      <template x-if="w.documentationUrl">
                        <a
                          class="pg-wcode"
                          x-bind:href="w.documentationUrl"
                          target="_blank"
                          rel="noopener"
                          x-text="w.code"></a>
                      </template>
                      <template x-if="!w.documentationUrl">
                        <span class="pg-wcode" x-text="w.code"></span>
                      </template>
                      <span class="pg-wpath pg-mono" x-text="w.path"></span>
                    </header>
                    <p x-text="w.message"></p>
                    <p class="pg-muted pg-whelp" x-show="w.help" x-text="w.help"></p>
                    <details class="pg-wexplain" x-show="w.definition">
                      <summary>What is this?</summary>
                      <p><strong x-text="w.definition?.title"></strong></p>
                      <p x-text="w.definition?.summary"></p>
                      <p class="pg-muted">
                        Category: <span x-text="w.definition?.category"></span> &middot; Typical
                        severity: <span x-text="w.definition?.typicalSeverity"></span>
                      </p>
                    </details>
                  </article>
                </template>
              </section>
            </div>
          </section>
        </div>
      </template>
    </div>

    <div class="pg-bottombar" x-show="summary">
      <label>
        Rows per root table
        <input type="number" min="1" x-model.number="rows" />
      </label>
      <label>
        Seed
        <input type="number" min="0" x-model.number="seed" />
      </label>
      <label>
        Output dialect
        <select x-model="outDialect">
          <option value="" x-text="summary ? 'same as source (' + summary.dialect + ')' : 'same as source'"></option>
          <option value="mysql">mysql</option>
          <option value="postgres">postgres</option>
          <option value="sqlite">sqlite</option>
          <option value="mssql">mssql</option>
        </select>
      </label>
      <label>
        Output
        <select x-model="outMode">
          <option value="schema_and_data">schema + data</option>
          <option value="schema_only">schema only</option>
          <option value="data_only">data only</option>
        </select>
      </label>
      <button
        class="pg-btn pg-btn-primary"
        x-on:click="generate()"
        x-bind:disabled="state === 'generating' || state === 'analyzing'"
      >
        &#9654; Generate
      </button>
      <span class="pg-muted pg-rows-note" x-show="rows > 100000">
        Large row counts can take a while and produce a very large script in browser memory.
      </span>
      <span class="pg-bottombar-spacer"></span>
      <button class="pg-btn" x-show="sql" x-on:click="copySql($event)">Copy</button>
      <button class="pg-btn" x-show="sql" x-on:click="downloadSql()">Download .sql</button>
    </div>
  </div>
</BaseLayout>

<script>
  import Alpine from 'alpinejs';
  import type { HighlighterCore } from 'shiki/core';

  interface ColumnInfo {
    name: string;
    sqlType: string;
    nullable: boolean;
    primaryKey: boolean;
    nullRate: number | null;
    distinctEstimate: number | null;
    generator: string | null;
    semantic: string | null;
    confidence: string | null;
    reason: string | null;
  }

  interface TableInfo {
    name: string;
    rowCount: number | null;
    foreignKeys: {
      columns: string[];
      referencedTable: string;
      referencedColumns: string[];
    }[];
    columns: ColumnInfo[];
  }

  interface WarningInfo {
    code: string;
    severity: string;
    path: string;
    message: string;
    help?: string;
    documentationUrl?: string;
    definition?: {
      title: string;
      category: string;
      typicalSeverity: string;
      summary: string;
    };
  }

  interface Summary {
    dialect: string;
    dialectDetected: boolean;
    tables: TableInfo[];
    warnings: WarningInfo[];
  }

  type WorkerReply =
    | { id: number; type: 'status'; stage: string }
    | { id: number; type: 'analyzed'; summary: Summary }
    | { id: number; type: 'generated'; sql: string; renderWarnings: WarningInfo[] }
    | { id: number; type: 'model'; yaml: string }
    | { id: number; type: 'error'; message: string; fatal: boolean };

  const MAGIC = [
    { bytes: [0x1f, 0x8b], name: 'gzip' },
    { bytes: [0x50, 0x4b], name: 'zip' },
    { bytes: [0x42, 0x5a, 0x68], name: 'bzip2' },
    { bytes: [0xfd, 0x37, 0x7a, 0x58, 0x5a], name: 'xz' },
    { bytes: [0x28, 0xb5, 0x2f, 0xfd], name: 'zstd' },
  ];
  const SOFT_WARN_BYTES = 100 * 1024 * 1024;
  const DISPLAY_CAP = 1024 * 1024;
  const HIGHLIGHT_CAP = 256 * 1024;

  let highlighterPromise: Promise<HighlighterCore> | null = null;
  async function getHighlighter(): Promise<HighlighterCore> {
    highlighterPromise ??= (async () => {
      const [{ createHighlighterCore }, { createJavaScriptRegexEngine }] = await Promise.all([
        import('shiki/core'),
        import('shiki/engine/javascript'),
      ]);
      return createHighlighterCore({
        themes: [import('@shikijs/themes/github-dark'), import('@shikijs/themes/github-light')],
        langs: [import('@shikijs/langs/sql'), import('@shikijs/langs/yaml')],
        engine: createJavaScriptRegexEngine(),
      });
    })();
    return highlighterPromise;
  }

  async function highlight(code: string, lang: 'sql' | 'yaml'): Promise<string | null> {
    try {
      const highlighter = await getHighlighter();
      return highlighter.codeToHtml(code, {
        lang,
        themes: { light: 'github-light', dark: 'github-dark' },
      });
    } catch {
      return null;
    }
  }

  function downloadBlob(text: string, filename: string, mime: string) {
    const blob = new Blob([text], { type: mime });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
  }

  function flashCopied(event: Event) {
    const btn = event.target as HTMLButtonElement;
    const original = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(() => (btn.textContent = original), 1500);
  }

  Alpine.data('playground', () => ({
    state: 'empty' as 'empty' | 'analyzing' | 'ready' | 'generating',
    dragging: false,
    fileName: null as string | null,
    dialect: 'auto',
    summary: null as Summary | null,
    selectedTable: null as string | null,
    tab: 'analysis' as 'analysis' | 'model' | 'sql' | 'warnings',
    rows: 100,
    seed: 42,
    outDialect: '',
    outMode: 'schema_and_data',
    sql: null as string | null,
    sqlHtml: null as string | null,
    renderWarnings: [] as WarningInfo[],
    modelYamlText: null as string | null,
    modelHtml: null as string | null,
    modelKey: null as string | null,
    modelLoading: false,
    error: null as string | null,
    perfWarning: null as string | null,

    worker: null as Worker | null,
    requestId: 0,

    init() {
      this.spawnWorker();
      for (const prop of ['rows', 'seed', 'outDialect', 'outMode']) {
        this.$watch(prop, () => {
          if (this.tab === 'model') this.ensureModel();
        });
      }
    },

    spawnWorker() {
      if (this.worker) this.worker.terminate();
      this.worker = new Worker('/wasm/worker.js', { type: 'module' });
      this.worker.onmessage = (event: MessageEvent<WorkerReply>) =>
        this.onWorkerMessage(event.data);
      this.worker.onerror = () => {
        this.state = this.summary ? 'ready' : 'empty';
        this.error = 'The WebAssembly worker failed to load.';
      };
    },

    onWorkerMessage(msg: WorkerReply) {
      if (msg.id !== this.requestId) return; // stale reply from a superseded request
      if (msg.type === 'analyzed') {
        this.summary = msg.summary;
        this.selectedTable = msg.summary.tables[0]?.name ?? null;
        this.tab = 'analysis';
        this.sql = null;
        this.sqlHtml = null;
        this.renderWarnings = [];
        this.modelYamlText = null;
        this.modelHtml = null;
        this.modelKey = null;
        this.state = 'ready';
      } else if (msg.type === 'generated') {
        this.sql = msg.sql;
        this.renderWarnings = msg.renderWarnings ?? [];
        this.tab = 'sql';
        this.state = 'ready';
        this.highlightSql();
      } else if (msg.type === 'model') {
        this.modelYamlText = msg.yaml;
        this.modelLoading = false;
        this.highlightModel();
      } else if (msg.type === 'error') {
        this.error = msg.message;
        this.modelLoading = false;
        if (msg.fatal) {
          this.spawnWorker();
          this.summary = null;
          this.fileName = null;
          this.state = 'empty';
        } else {
          this.state = this.summary ? 'ready' : 'empty';
        }
      }
    },

    get currentTable() {
      return this.summary?.tables.find((t: TableInfo) => t.name === this.selectedTable) ?? null;
    },

    get warningCount() {
      return (this.summary?.warnings.length ?? 0) + this.renderWarnings.length;
    },

    get displaySql() {
      if (!this.sql) return '';
      return this.sql.length > DISPLAY_CAP ? this.sql.slice(0, DISPLAY_CAP) : this.sql;
    },

    get sqlTruncatedNote() {
      if (!this.sql || this.sql.length <= DISPLAY_CAP) return null;
      const totalMb = (this.sql.length / (1024 * 1024)).toFixed(1);
      return `Showing the first 1 MB of ${totalMb} MB — Download gets the full script.`;
    },

    get modelRequestKey() {
      return `${this.rows}:${this.seed}:${this.outDialect}:${this.outMode}`;
    },

    switchTab(tab: 'analysis' | 'model' | 'sql' | 'warnings') {
      this.tab = tab;
      if (tab === 'model') this.ensureModel();
    },

    ensureModel() {
      if (!this.summary || this.state === 'analyzing') return;
      if (this.modelYamlText && this.modelKey === this.modelRequestKey) return;
      this.modelKey = this.modelRequestKey;
      this.modelLoading = true;
      // Reuses the current request id: a model reply must not be treated as
      // stale by an unrelated generate, and a new analyze still supersedes it.
      this.worker?.postMessage({
        id: this.requestId,
        type: 'model',
        rows: this.rows || 100,
        seed: this.seed || 0,
        dialect: this.outDialect || null,
        mode: this.outMode,
      });
    },

    async highlightSql() {
      this.sqlHtml = null;
      const text = this.displaySql;
      if (!text || text.length > HIGHLIGHT_CAP) return;
      const generation = this.requestId;
      const html = await highlight(text, 'sql');
      if (generation === this.requestId) this.sqlHtml = html;
    },

    async highlightModel() {
      this.modelHtml = null;
      if (!this.modelYamlText) return;
      const key = this.modelKey;
      const html = await highlight(this.modelYamlText, 'yaml');
      if (key === this.modelKey) this.modelHtml = html;
    },

    async openFile(file: File | null | undefined) {
      if (!file) return;
      this.error = null;
      this.perfWarning = null;

      const buffer = await file.arrayBuffer();
      const head = new Uint8Array(buffer, 0, Math.min(8, buffer.byteLength));
      const compressed = MAGIC.find((m) => m.bytes.every((b, i) => head[i] === b));
      if (compressed) {
        this.error = `This looks like a ${compressed.name} archive. Compressed dumps aren't supported in the browser — decompress it first, or use the CLI (which reads them natively).`;
        return;
      }
      if (file.size >= SOFT_WARN_BYTES) {
        const mb = Math.round(file.size / (1024 * 1024));
        this.perfWarning = `${mb} MB dump — analysis runs locally and may take a while, briefly using roughly twice the file size in memory. Leave the tab open.`;
      }

      this.fileName = file.name;
      this.analyze(buffer);
    },

    async loadExample(name: string) {
      this.error = null;
      this.perfWarning = null;
      const response = await fetch(`/playground/${name}`);
      const buffer = await response.arrayBuffer();
      this.fileName = name;
      this.analyze(buffer);
    },

    analyze(buffer: ArrayBuffer) {
      this.state = 'analyzing';
      this.summary = null;
      this.sql = null;
      this.sqlHtml = null;
      const id = ++this.requestId;
      const dialect = this.dialect === 'auto' ? null : this.dialect;
      this.worker?.postMessage({ id, type: 'analyze', buffer, dialect }, [buffer]);
    },

    generate() {
      if (!this.summary) return;
      this.error = null;
      this.state = 'generating';
      this.tab = 'sql';
      const id = ++this.requestId;
      this.worker?.postMessage({
        id,
        type: 'generate',
        rows: this.rows || 100,
        seed: this.seed || 0,
        dialect: this.outDialect || null,
        mode: this.outMode,
      });
    },

    copySql(event: Event) {
      if (!this.sql) return;
      navigator.clipboard.writeText(this.sql).then(() => flashCopied(event));
    },

    copyModel(event: Event) {
      if (!this.modelYamlText) return;
      navigator.clipboard.writeText(this.modelYamlText).then(() => flashCopied(event));
    },

    downloadSql() {
      if (!this.sql) return;
      downloadBlob(this.sql, 'synthetic.sql', 'application/sql');
    },

    downloadModel() {
      if (!this.modelYamlText) return;
      downloadBlob(this.modelYamlText, 'model.yaml', 'application/yaml');
    },
  }));

  Alpine.start();
</script>

